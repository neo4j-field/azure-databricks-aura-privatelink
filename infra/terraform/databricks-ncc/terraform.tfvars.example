# ----------------------------------------------------------------------------
# Copy to terraform.tfvars (gitignored) and fill in real values before applying.
# This is the NCC stack, for Azure Databricks Serverless. For the Private
# Endpoint stack (classic clusters, AKS, ADF, jump VMs), use ../azure-private-endpoint/.
# ----------------------------------------------------------------------------

# ---- Databricks account / workspace ----------------------------------------
# Find your account_id at https://accounts.azuredatabricks.net (top-right user
# menu shows it once you're signed in as an account admin).
databricks_account_id    = "REPLACE_WITH_DATABRICKS_ACCOUNT_ID"

# Workspace numeric ID (from the workspace URL between `adb-` and `.<digit>`)
# and the full workspace URL.
databricks_workspace_id  = "REPLACE_WITH_WORKSPACE_ID"
databricks_workspace_url = "https://adb-REPLACE_ME.REPLACE_ME.azuredatabricks.net"

# ---- Auth (pick ONE path) ---------------------------------------------------
#
# Path A: Azure CLI (recommended for a one-off bootstrap)
#   1. az login --tenant <tenant-id>
#   2. Ensure the signed-in user is a Databricks account admin
#      (accounts.azuredatabricks.net -> User management -> Admins)
#   3. Leave the three azure_* lines below commented out.
#
# Path B: Service principal (recommended for CI/CD)
#   1. Create an SP in Azure AD, grant it account-admin in the Databricks
#      Account Console -> User management -> Service principals.
#   2. Uncomment and fill in the three lines below.
#
# azure_client_id     = "REPLACE_WITH_SP_CLIENT_ID"
# azure_client_secret = "REPLACE_WITH_SP_CLIENT_SECRET"
# azure_tenant_id     = "REPLACE_WITH_TENANT_ID"

# ---- Region & naming --------------------------------------------------------
# Must match the Databricks workspace region exactly, for example eastus.
azure_region = "REPLACE_WITH_WORKSPACE_REGION"

# NCC name, lowercase and hyphen-delimited. The recommended name matches the
# stack default and the manual guide.
ncc_name = "ncc-aura-privatelink"

# ---- Neo4j Aura PLS targets (from the Aura console, see docs/shared/aura-console-steps.md Step 2) ----------
# `aura_pls_resource_id` is the PLS alias surfaced in the Aura UI, e.g.:
#   production-orch-<id>-service.<guid>.<region>.azure.privatelinkservice
aura_pls_resource_id = "REPLACE_WITH_AURA_PLS_ALIAS"

# `aura_private_hostname` is the hostname your driver will connect to.
# Take it from the Aura instance's Private URI (e.g.,
# neo4j+s://<aura-instance-id>.databases.neo4j.io). For third-party PLS the provider
# expects only `resource_id` + `domain_names`; `group_id` is reserved for
# first-party Azure services and must not be set here.
aura_private_hostname = "REPLACE_WITH_AURA_PRIVATE_HOSTNAME"   # e.g., <aura-instance-id>.databases.neo4j.io

# Optional: Bolt routing hosts such as p-<aura-instance-id>-<suffix>.<orch>.neo4j.io.
# The repository notebooks map these hosts back to the instance host, so they
# pass with this list empty. Add a host here when a client without such a
# resolver reports `Cannot resolve address` for it. The error names the host.
aura_extra_domain_names = []
