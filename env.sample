# Copy to .env and fill in. .env is gitignored. Never commit real values.
#   cp env.sample .env
#
# One file feeds every path in docs/:
#   - scripts/private_link.py, scripts/automate.py and scripts/create-secret-scope.sh read it directly.
#   - For the manual commands in docs/, load it into your shell (bash or zsh):
#       source scripts/load-env.sh
#     Run it again after you edit .env. The .env value replaces any value already exported.
#
# Fill in only the sections for the path you follow. Leave a line commented out when you do not need it.
# Keep a value on one line, as KEY="value". Do not leave <placeholders> in a line you keep.
# scripts/private_link.py reads this file only and ignores exported variables.

# ---------------------------------------------------------------------------
# Neo4j Aura (all paths)
# ---------------------------------------------------------------------------

# Credentials stored in the `neo4j` secret scope.
# The URI host is the instance host. It must match the Private URI host in the NCC private endpoint rule.
NEO4J_URI="neo4j+s://<aura-instance-id>.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="<aura-password>"
NEO4J_DATABASE="neo4j"   # optional, defaults to neo4j

# Private Link service name, from the Aura console. Used by both the Private Link and the NCC paths.
AURA_PLS_ALIAS="production-orch-<id>-service.<guid>.<region>.azure.privatelinkservice"

# AURA_PRIVATE_HOSTNAME="<aura-instance-id>.databases.neo4j.io"   # the instance host, the host of NEO4J_URI. Derived when unset.
# AURA_INSTANCE_ID="<aura-instance-id>"                           # the instance ID, the first label of the instance host. Derived when unset.
# AURA_EXTRA_DOMAIN_NAMES="<host1>,<host2>"                       # optional, scripts/create-private-endpoint-rule.sh
# ROUTING_HOST="p-<aura-instance-id>-<suffix>.<orch>.neo4j.io"    # only after a client reports it in an error

# ---------------------------------------------------------------------------
# Databricks (all paths)
# ---------------------------------------------------------------------------

# Databricks CLI profile for the workspace (see `databricks auth profiles`)
WORKSPACE_PROFILE="<workspace-profile>"

# WORKSPACE_NAME="<databricks-workspace-name>"   # also picks the VNet-injected workspace for scripts/private_link.py. scripts/databricks_vnet_workspace.py creates it with this name (default dbx-aura-pl-test).
# WS_RG="<workspace-resource-group>"             # resource group of that workspace
# WORKSPACE_URL="<workspace-url>"                # for example https://adb-123.4.azuredatabricks.net.

# ---------------------------------------------------------------------------
# Databricks account (NCC path)
# ---------------------------------------------------------------------------

# ACCOUNT_PROFILE="<account-profile>"            # CLI profile for accounts.azuredatabricks.net
# DATABRICKS_ACCOUNT_ID="<databricks-account-id>"
# NCC_REGION="<azure-region>"                    # the workspace region, for example eastus2

# ---------------------------------------------------------------------------
# Azure network (Private Link path)
# ---------------------------------------------------------------------------

# Only AURA_PLS_ALIAS is required for scripts/private_link.py. It finds the rest from NEO4J_URI
# and Azure when they are unset. The manual commands need every value, so set them all.
# PE_RG="<resource-group>"                       # holds the endpoint and the DNS zone
# VNET="<vnet-name>"
# VNET_RG="<vnet-resource-group>"                # defaults to PE_RG when unset
# PE_SUBNET="<subnet-name>"
# PE_NAME="pe-<aura-instance-id>-<region>"
# REQUEST_MESSAGE="Neo4j Aura Private Link from <team>"   # shown on the Aura approval screen
# HUB_RG="<hub-resource-group>"                  # central hub DNS only: the group that owns the private DNS zones
# ZONE="databases.neo4j.io"                      # defaults to this value when unset

# ---------------------------------------------------------------------------
# Set by the steps, not here
# ---------------------------------------------------------------------------
# The docs read these back from Azure or Databricks and export them as you go, so do not put them in .env:
#   NCC_ID, RULE_ID, PLACEHOLDER_NCC_ID, ORIGINAL_NCC_ID                 (account console)
#   PE_IP, NIC_ID, VNET_ID, SUBNET_ID                                    (Azure)
#   NOTEBOOK_DIR                                                         (workspace)
#   DATABRICKS_TOKEN                                                     (az account get-access-token)
# WORKSPACE_ID: after `databricks auth login`, run LOAD_ENV_LOOKUP=1 source scripts/load-env.sh to look it up.
# load-env.sh derives these from the values above: ORCH_ZONE and ROUTING_LABEL (from ROUTING_HOST).
