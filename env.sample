# Copy to .env and fill in. .env is gitignored. Never commit real values.
#   cp env.sample .env
#
# Read by scripts/create-secret-scope.sh. scripts/automate.py also reads the NEO4J_* values.
# An exported environment variable overrides the value here, except for scripts/private_link.py.

# Databricks CLI profile for the workspace (see `databricks auth profiles`)
WORKSPACE_PROFILE="<workspace-profile>"

# Aura credentials stored in the `neo4j` secret scope.
# The URI host must match the Private URI host in the NCC private endpoint rule.
NEO4J_URI="neo4j+s://<aura-instance-id>.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="<aura-password>"
NEO4J_DATABASE="neo4j"   # optional, defaults to neo4j

# Read by scripts/private_link.py (Private Link path), from this file only. It has no flags
# for these and ignores exported variables. Only AURA_PLS_ALIAS is required. The script
# finds the rest from NEO4J_URI and Azure when they are unset.
AURA_PLS_ALIAS="production-orch-<id>-service.<guid>.<region>.azure.privatelinkservice"
# WORKSPACE_NAME="<databricks-workspace-name>"   # VNet-injected workspace to take the VNet from
# RG="<resource-group>"
# VNET="<vnet-name>"
# VNET_RG="<vnet-resource-group>"
# PE_SUBNET="<subnet-name>"
# PE_NAME="pe-<aura-instance-id>-<region>"
# AURA_INSTANCE_ID="<aura-instance-id>"
# REQUEST_MESSAGE="Neo4j Aura Private Link from <team>"   # shown on the Aura approval screen
